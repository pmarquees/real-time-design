{
  "name": "real-time-design",
  "version": "0.1.2",
  "description": "Realtime voice-to-Codex terminal for hands-free coding.",
  "license": "MIT",
  "author": "Pedro Marques",
  "homepage": "https://github.com/pmarquees/real-time-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmarquees/real-time-design.git"
  },
  "bugs": {
    "url": "https://github.com/pmarquees/real-time-design/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "realtime",
    "voice",
    "cli",
    "tui",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "rtd": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test:scheduler": "npm run build && node scripts/scheduler-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "ink": "^5.1.0",
    "node-record-lpcm16": "^1.0.1",
    "react": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
